/* ============================================
   Media Tracker - Domain Model (Séries + Filmes + Jogos)
   ======================================================

   Este arquivo contém a modelagem DDD completa do sistema
   Media Tracker, cobrindo rastreamento de séries, filmes e jogos eletrônicos.

   Subdomínios:
   1. SeriesCatalog (SUPPORTING_DOMAIN) - Dados de séries
   2. MovieCatalog (SUPPORTING_DOMAIN) - Dados de filmes
   3. GameCatalog (SUPPORTING_DOMAIN) - Dados de jogos eletrônicos
   4. UserTracking (CORE_DOMAIN) - Rastreamento pessoal
   5. Recommendation (CORE_DOMAIN) - Sistema de recomendação
   6. UserExperience (CORE_DOMAIN) - Experiência do usuário
   7. Social (CORE_DOMAIN) - Rede social e descoberta de usuários

   Bounded Contexts:
   - SeriesCatalogContext (Backend)
   - MovieCatalogContext (Backend)
   - GameCatalogContext (Backend) - NOVO
   - UserTrackingContext (Backend)
   - RecommendationContext (Backend)
   - SocialContext (Backend)
   - ExperienceContext (Frontend)
   - ExperienceBFFContext (Backend for Frontend)

   Atualizado em: 2026-06-13
   ============================================ */

// ---- Domínio e Subdomínios ----

Domain MediaTracker {
  domainVisionStatement = "Plataforma de rastreamento pessoal de séries, jogos, filmes e outros conteúdos de entretenimento, com foco em experiência do usuário."

  Subdomain SeriesCatalog {
    type = SUPPORTING_DOMAIN
    domainVisionStatement = "Gerencia informações sobre séries, temporadas e episódios. Dados estruturais do conteúdo."

    Entity Series {
      String title
      String seriesDescription
      String genre
      int totalSeasons
    }
  }

  Subdomain MovieCatalog {
    type = SUPPORTING_DOMAIN
    domainVisionStatement = "Gerencia informações sobre filmes. Dados estruturais do conteúdo cinematográfico."

    Entity Movie {
      String title
      String overview
      String genre
      int runtime
      Date releaseDate
    }
  }

  Subdomain GameCatalog {
    type = SUPPORTING_DOMAIN
    domainVisionStatement = "Gerencia informações sobre jogos eletrônicos. Dados estruturais de catálogo, plataformas, empresas, franquias e modos de jogo."

    Entity Game {
      String title
      String summary
      String genre
      String coverUrl
      Date releaseDate
      String platforms
      String developer
      String publisher
      String franchise
      String gameModes
      String igdbId
    }
  }

  Subdomain UserTracking {
    type = CORE_DOMAIN
    domainVisionStatement = "Permite ao usuário rastrear seu progresso, avaliar conteúdo e manter listas pessoais. Diferencial competitivo na organização pessoal."

    Entity TrackedMedia {
      String mediaId
      String mediaType
      String status
      int rating
    }
  }

  Subdomain Recommendation {
    type = CORE_DOMAIN
    domainVisionStatement = "Sugere conteúdo quando o usuário está ocioso, baseado em sua lista de interesse. Diferencial na descoberta de conteúdo."
  }

  Subdomain Social {
    type = CORE_DOMAIN
    domainVisionStatement = "Permite que usuários se conectem, sigam uns aos outros e descubram pessoas com interesses similares. Diferencial competitivo na dimensão social da plataforma."

    Entity UserProfile {
      String displayName
      String avatarUrl
      boolean isPublic
    }

    Entity FollowRelationship {
      String followerId
      String followedId
    }

    Entity ActivityEvent {
      String activityType
      String mediaId
      String mediaType
    }
  }

  Subdomain UserExperience {
    type = CORE_DOMAIN
    domainVisionStatement = "Responsável pela interface, interações, navegação e apresentação. Diferencial competitivo na usabilidade e experiência do usuário."
  }
}

// ---- Bounded Contexts Backend ----

BoundedContext SeriesCatalogContext implements SeriesCatalog {
  type = FEATURE
  domainVisionStatement = "Contexto responsável por gerenciar dados de séries, temporadas e episódios. Fonte da verdade sobre conteúdo disponível."
  implementationTechnology = "Go / AWS Lambda"
  responsibilities = "Series", "Seasons", "Episodes", "Metadata"
  knowledgeLevel = CONCRETE
}

BoundedContext MovieCatalogContext implements MovieCatalog {
  type = FEATURE
  domainVisionStatement = "Contexto responsável por gerenciar dados de filmes. Fonte da verdade sobre conteúdo cinematográfico disponível."
  implementationTechnology = "Go / AWS Lambda"
  responsibilities = "Movies", "Metadata"
  knowledgeLevel = CONCRETE
}

BoundedContext GameCatalogContext implements GameCatalog {
  type = FEATURE
  domainVisionStatement = "Contexto responsável por gerenciar dados de jogos eletrônicos. Fonte da verdade sobre metadados de jogos disponíveis."
  implementationTechnology = "Go / AWS Lambda"
  responsibilities = "Games", "Platforms", "Companies", "Franchises", "GameModes", "IGDBIntegration", "Metadata"
  knowledgeLevel = CONCRETE

  Aggregate GameCatalog {
    responsibilities = "Catálogo de jogos eletrônicos e metadados normalizados a partir da IGDB"
    likelihoodForChange = NORMAL
    contentVolatility = OFTEN

    Entity Game {
      aggregateRoot

      - GameId gameId
      String title
      String summary
      String genre
      String coverUrl
      Date releaseDate
      String platforms
      String developer
      String publisher
      String franchise
      String gameModes
      String igdbId
      Date lastUpdated
    }

    ValueObject GameId {
      String id key
    }

    ValueObject ProviderGameId {
      String id key
    }
  }
}

BoundedContext UserTrackingContext implements UserTracking {
  type = FEATURE
  domainVisionStatement = "Contexto responsável por rastrear o progresso pessoal do usuário, status, avaliações, reviews e preferências específicas de cada tipo de mídia."
  implementationTechnology = "Go / AWS Lambda"
  responsibilities = "Tracking", "Ratings", "UserLists", "Progress"
  knowledgeLevel = CONCRETE

  Aggregate UserMediaTracking {
    responsibilities = "Rastreamento de uma mídia específica para um usuário"
    likelihoodForChange = OFTEN
    contentVolatility = OFTEN

    Entity TrackedMedia {
      aggregateRoot

      - TrackingId trackingId
      - UserId userId
      - MediaId mediaId
      - MediaType mediaType
      TrackingStatus status
      GameTrackingStatus gameStatus
      - List<SeasonRating> seasonRatings
      Integer rating // 1-10, nullable
      String review
      String selectedPlatform // Jogos: plataforma escolhida pelo usuário
      int hoursPlayed // Jogos: horas jogadas, não negativo
      Date addedAt
      Date lastUpdated
    }

    ValueObject TrackingId {
      String id key
    }

    ValueObject UserId {
      String id key
    }

    ValueObject MediaId {
      String id key
    }

    ValueObject MediaType {
      String value key
    }

    ValueObject SeasonRating {
      int seasonNumber key
      int rating // 1-10
      Date ratedAt
    }

    enum MediaTypeEnum {
      SERIES, MOVIE, GAME
    }

    enum TrackingStatus {
      aggregateLifecycle
      WANT_TO_WATCH,    // Quero Assistir
      WATCHING,         // Assistindo
      COMPLETED,        // Concluída
      DROPPED           // Dropada
    }

    enum GameTrackingStatus {
      aggregateLifecycle
      WANT_TO_PLAY,     // Quero Jogar
      PLAYING,          // Jogando
      COMPLETED,        // Concluído/Zerado
      DROPPED           // Dropado
    }
  }
}

BoundedContext SocialContext implements Social {
  type = FEATURE
  domainVisionStatement = "Contexto responsável por perfis públicos de usuários, grafo social (follow/unfollow), feed de atividades e descoberta de usuários com interesses similares."
  implementationTechnology = "Go / AWS Lambda"
  responsibilities = "UserProfiles", "SocialGraph", "ActivityFeed", "UserDiscovery"
  knowledgeLevel = CONCRETE

  Aggregate UserProfile {
    responsibilities = "Representação pública de um usuário na rede social"
    likelihoodForChange = NORMAL
    contentVolatility = NORMAL

    Entity UserProfile {
      aggregateRoot

      - UserId userId
      String displayName
      String avatarUrl
      boolean isPublic
      Date createdAt
      Date updatedAt
    }

    ValueObject UserId {
      String id key
    }
  }

  Aggregate SocialGraph {
    responsibilities = "Grafo de relacionamentos follow/unfollow entre usuários"
    likelihoodForChange = NORMAL
    contentVolatility = NORMAL

    Entity FollowRelationship {
      aggregateRoot

      - UserId followerId
      - UserId followedId
      Date followedAt
    }

    ValueObject UserId {
      String id key
    }
  }

  Aggregate ActivityFeed {
    responsibilities = "Feed cronológico de atividades dos usuários seguidos"
    likelihoodForChange = NORMAL
    contentVolatility = OFTEN

    Entity ActivityEvent {
      aggregateRoot

      - EventId eventId
      - UserId userId
      ActivityType activityType
      - MediaId mediaId
      - MediaType mediaType
      String mediaTitle
      Date createdAt
    }

    ValueObject EventId {
      String id key
    }

    ValueObject UserId {
      String id key
    }

    ValueObject MediaId {
      String id key
    }

    ValueObject MediaType {
      String value key
    }

    enum ActivityType {
      STARTED_WATCHING,  // Começou a assistir
      RATED,             // Avaliou com nota
      REVIEWED,          // Escreveu/revisou review
      COMPLETED,         // Concluiu
      DROPPED,           // Dropou
      ADDED_TO_LIST      // Adicionou à lista
    }
  }
}

BoundedContext RecommendationContext implements Recommendation {
  type = FEATURE
  domainVisionStatement = "Contexto responsável por sugerir conteúdo quando o usuário está ocioso, baseado em sua lista de interesse."
  implementationTechnology = "Go in AWS Lambda"
  responsibilities = "Recommendations", "RandomSelection", "IdleSuggestions"
  knowledgeLevel = CONCRETE
}

// ---- Bounded Contexts Frontend/Experiência ----

BoundedContext ExperienceContext implements UserExperience {
  type = FEATURE
  domainVisionStatement = "Aplicação frontend responsável pela interface do usuário, navegação, apresentação e interações. Foco em UX agradável e intuitiva."
  implementationTechnology = "To be Defined"
  responsibilities = "UI", "UX", "Navigation", "Presentation"
  knowledgeLevel = CONCRETE
}

BoundedContext ExperienceBFFContext implements UserExperience {
  type = FEATURE
  domainVisionStatement = "Backend for Frontend (BFF) que agrega dados dos contextos de domínio para fornecer APIs otimizadas para a interface do ExperienceContext."
  implementationTechnology = "AWS Lambda / Go"
  responsibilities = "Aggregation", "API Composition", "FrontendOptimization"
  knowledgeLevel = CONCRETE
}

// ---- Context Map ----

ContextMap MediaTrackerMap {
  type = SYSTEM_LANDSCAPE
  state = TO_BE

  contains SeriesCatalogContext, MovieCatalogContext, UserTrackingContext, RecommendationContext, SocialContext, ExperienceContext, ExperienceBFFContext

  // UserTracking consome dados dos catálogos para validar mídias
  UserTrackingContext [D,CF] <- [U,OHS,PL] SeriesCatalogContext

  UserTrackingContext [D,CF] <- [U,OHS,PL] MovieCatalogContext

  // Recommendation consome lista "Quero Assistir" do UserTracking
  RecommendationContext [D,CF] <- [U,OHS,PL] UserTrackingContext

  // ExperienceBFF agrega dados de todos os contextos de domínio
  ExperienceBFFContext [D,CF] <- [U,OHS,PL] SeriesCatalogContext

  ExperienceBFFContext [D,CF] <- [U,OHS,PL] MovieCatalogContext

  ExperienceBFFContext [D,CF] <- [U,OHS,PL] UserTrackingContext

  ExperienceBFFContext [D,CF] <- [U,OHS,PL] RecommendationContext

  // UserTracking emite domain events que SocialContext consome (feed de atividades)
  // UserTracking é UPSTREAM, SocialContext é DOWNSTREAM
  SocialContext [D,CF] <- [U,OHS,PL] UserTrackingContext {
    implementationTechnology = "Domain Events: TrackingActionCompleted"
  }

  // SocialContext consulta UserTracking para discovery de usuários similares
  SocialContext [D,CF] <- [U,OHS,PL] UserTrackingContext {
    implementationTechnology = "HTTP: GET /internal/summary/{userId}"
  }

  // ExperienceBFF agrega SocialContext para rotas sociais
  ExperienceBFFContext [D,CF] <- [U,OHS,PL] SocialContext

  // Experience (Frontend) consome apenas o BFF
  ExperienceContext [D,C] <- [U,S] ExperienceBFFContext
}
